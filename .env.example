NAVER_AGENT_TOKEN=replace-with-a-long-random-value
# Required for the staff-only team list, walk-in list, and reservation list.
TEAM_LIST_PASSWORD=replace-with-a-long-random-value

# Keep the new operation data separate from the current D:\game_monitor service.
GAME_MONITOR_DB_PATH=D:\JumpingBattle_SuwonYT\data\game_data.db
GAME_MONITOR_LOG_DIR=D:\JumpingBattle_SuwonYT\logs
