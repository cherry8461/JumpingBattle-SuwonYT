GAME_MONITOR_HOST=127.0.0.1
GAME_MONITOR_PORT=8081

# Fill these only in the local .env file. Never commit the real values.
GMAIL_USER=your-store-email@example.com
GMAIL_APP_PASSWORD=your-google-app-password
